{
  "name": "clutterdock",
  "productName": "ClutterDock",
  "version": "1.3.1",
  "description": "Free app folders for your Windows taskbar / tray — group apps, files, folders, and URLs.",
  "main": "src/main.js",
  "author": "Ronald",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/rbakman-rgb/clutterdock.git"
  },
  "homepage": "https://clutterdock.com/",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "test": "node scripts/test-license.js && node scripts/test-store.js",
    "e2e": "node scripts/e2e.js",
    "stress": "node scripts/stress.js",
    "pack": "electron-builder --dir",
    "predist": "node scripts/write-license-secret.js --require && npm test",
    "dist": "electron-builder --win --publish never",
    "predist:portable": "node scripts/write-license-secret.js --require && npm test",
    "dist:portable": "electron-builder --win portable --publish never"
  },
  "build": {
    "appId": "com.ronald.ClutterDock",
    "productName": "ClutterDock",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "rbakman-rgb",
        "repo": "clutterdock"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "shortcutName": "ClutterDock",
      "runAfterFinish": true,
      "artifactName": "ClutterDock-${version}-${arch}-setup.${ext}"
    },
    "portable": {
      "artifactName": "ClutterDock-${version}-${arch}-portable.${ext}"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "playwright-core": "^1.62.1"
  }
}
